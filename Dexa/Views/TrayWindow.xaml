<views:BaseWindow x:Class="Dexa.Views.TrayWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:Dexa.Views"
                  xmlns:viewModels="clr-namespace:Dexa.ViewModels"
                  xmlns:converters="clr-namespace:Dexa.Converters"
                  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance viewModels:TrayWindowViewModel}"
                  Title="Dexa Tray"
                  Icon="/Icons/Dexa.ico"
                  SizeToContent="WidthAndHeight"
                  WindowStyle="None" AllowsTransparency="True" Background="Transparent"
                  ShowInTaskbar="False" Topmost="True" Deactivated="Window_Deactivated">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="WindowActivated">
            <i:InvokeCommandAction Command="{Binding RefreshDevicesCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToDoubleConverter x:Key="BooleanToDoubleConverter" />
        <converters:BooleanToColorConverter x:Key="BooleanToColorConverter" />
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1b2838" />
            <Setter Property="Foreground" Value="#66c0f4" />
            <Setter Property="BorderBrush" Value="#66c0f4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10, 5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#66c0f4" />
                                <Setter Property="Foreground" Value="#1b2838" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#171a21" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#66c0f4" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66c0f4" />
                                <Setter Property="Foreground" Value="#1b2838" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Border Background="#171a21" BorderBrush="#000000" BorderThickness="1" CornerRadius="5" Padding="8">
        <StackPanel>
            <TextBlock Text="No connected devices" Margin="5" HorizontalAlignment="Center" Foreground="#66c0f4"
                       Visibility="{Binding IsDeviceListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ListBox ItemsSource="{Binding Devices}" Margin="0" BorderBrush="Transparent" BorderThickness="0"
                     Padding="0"
                     Visibility="{Binding IsDeviceListEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,6"
                                    Opacity="{Binding IsAvailable, Converter={StaticResource BooleanToDoubleConverter}, ConverterParameter=1.0_0.7}">
                            <Border CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#00ff90"/>
                                                <Setter Property="Background" Value="#0d1117"/>
                                                <Setter Property="Padding" Value="4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" HorizontalAlignment="Stretch" Margin="0"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.TurnOnDeviceCommand}"
                                                CommandParameter="{Binding}"
                                                BorderBrush="{Binding IsRunning, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#00ff90_#66c0f4}">
                                            <TextBlock Margin="10,4" FontSize="13" FontWeight="Medium" Text="{Binding FriendlyName}"
                                                       Foreground="{Binding IsRunning, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#ffffff_#c8dff0}"/>
                                        </Button>
                                        <Button Grid.Column="1" FontFamily="Segoe MDL2 Assets" Margin="4,0,0,0"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.ConnectWirelessCommand}"
                                                CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                BorderBrush="{Binding IsRunning, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#00ff90_#66c0f4}"
                                                Visibility="{Binding CanBeRemoteConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Margin="10,3" Text="&#xE703;"
                                                       Foreground="{Binding IsRunning, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#ffffff_#c8dff0}"/>
                                        </Button>
                                        <Button Grid.Column="1" FontFamily="Segoe MDL2 Assets" Margin="4,0,0,0"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.DisconnectWirelessCommand}"
                                                CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                BorderBrush="{Binding IsRunning, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#00ff90_#66c0f4}"
                                                Visibility="{Binding IsRemoteConnection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Margin="10,3" Text="&#xE711;"
                                                       Foreground="{Binding IsRunning, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#ffffff_#c8dff0}"/>
                                        </Button>
                                    </Grid>
                                    <UniformGrid Rows="1" Margin="0,4,0,0"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Margin="0,0,2,0" Padding="4,5"
                                                ToolTip="Fullscreen (F11)"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.ToggleFullscreenCommand}"
                                                CommandParameter="{Binding}"
                                                BorderBrush="{Binding IsFullscreen, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#00ff90_#66c0f4}">
                                            <TextBlock Margin="0,5" FontSize="12" FontFamily="Segoe MDL2 Assets" Text="&#xE740;"
                                                       Foreground="{Binding IsFullscreen, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#00ff90_#66c0f4}"/>
                                        </Button>
                                        <Button Margin="0,0,2,0" Padding="4,5"
                                                ToolTip="Game mode (F9)"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.ToggleGameModeCommand}"
                                                CommandParameter="{Binding}"
                                                BorderBrush="{Binding IsGameMode, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#00ff90_#66c0f4}">
                                            <TextBlock Margin="0,5" FontSize="12" FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;"
                                                       Foreground="{Binding IsGameMode, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#00ff90_#66c0f4}"/>
                                        </Button>
                                        <Button Margin="0,0,2,0" Padding="4,5"
                                                ToolTip="Record screen"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.ToggleRecordingCommand}"
                                                CommandParameter="{Binding}"
                                                BorderBrush="{Binding IsRecording, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#ff4444_#66c0f4}">
                                            <TextBlock Margin="0,5" FontSize="12" FontFamily="Segoe MDL2 Assets"
                                                       Text="{Binding IsRecording, Converter={StaticResource BooleanToStringConverter}, ConverterParameter=&#xE71A;_&#xE714;}"
                                                       Foreground="{Binding IsRecording, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#ff4444_#66c0f4}"/>
                                        </Button>
                                        <Button Margin="0,0,2,0" Padding="4,5"
                                                ToolTip="Rotate phone screen (F10)"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.ToggleOrientationCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Margin="0,5" FontSize="12" FontFamily="Segoe MDL2 Assets" Text="&#xE7AD;"/>
                                        </Button>
                                        <Button Margin="0,0,2,0" Padding="4,5"
                                                ToolTip="Go to phone home screen"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.ShowDesktopCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Margin="0,5" FontSize="12" FontFamily="Segoe MDL2 Assets" Text="&#xE80F;"/>
                                        </Button>
                                        <Button Padding="4,5"
                                                ToolTip="Always on top"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.ToggleAlwaysOnTopCommand}"
                                                CommandParameter="{Binding}"
                                                BorderBrush="{Binding IsAlwaysOnTop, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#00ff90_#66c0f4}">
                                            <TextBlock Margin="0,5" FontSize="12" FontFamily="Segoe MDL2 Assets" Text="&#xE840;"
                                                       Foreground="{Binding IsAlwaysOnTop, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#00ff90_#66c0f4}"/>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <UniformGrid Columns="2" Margin="0,0,0,5">
                <Button Command="{Binding ToggleKeyboardCommand}" Margin="0,0,1,1"
                        ToolTip="VIRTUAL: PC keyboard types text, the phone still shows its on-screen keyboard.&#x0a;PHYSICAL: the phone treats the PC keyboard as a physical one (no on-screen keyboard, gamepad supported).&#x0a;Click to switch mode (restarts mirroring)."
                        Opacity="{Binding IsKeyboardEnabled, Converter={StaticResource BooleanToDoubleConverter}, ConverterParameter=1.0_0.7}"
                        BorderBrush="{Binding IsKeyboardEnabled, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#66c0f4_#66c0f4}">
                    <TextBlock Margin="10,3" FontSize="13"
                               Text="{Binding IsKeyboardEnabled, Converter={StaticResource BooleanToStringConverter}, ConverterParameter=VIRTUAL__KEYBOARD_PHYSICAL__KEYBOARD}"
                               Foreground="{Binding IsKeyboardEnabled, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#66c0f4_#66c0f4}"/>
                </Button>

                <Button Command="{Binding ToggleScreenCommand}" Margin="1,0,0,1"
                        ToolTip="ON: the phone screen stays on while mirroring.&#x0a;OFF: the phone screen is turned off, the image is visible only on the PC.&#x0a;Click to switch mode (restarts mirroring)."
                        Opacity="{Binding IsScreenOffEnabled, Converter={StaticResource BooleanToDoubleConverter}, ConverterParameter=1.0_0.7}"
                        BorderBrush="{Binding IsScreenOffEnabled, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#66c0f4_#66c0f4}">
                    <TextBlock Margin="10,3" FontSize="13"
                               Text="{Binding IsScreenOffEnabled, Converter={StaticResource BooleanToStringConverter}, ConverterParameter=PHONE__SCREEN__ON_PHONE__SCREEN__OFF}"
                               Foreground="{Binding IsScreenOffEnabled, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#66c0f4_#66c0f4}"/>
                </Button>

                <Button Command="{Binding ToggleAspectRatioCommand}" Margin="0,1,1,0"
                        ToolTip="FREE WINDOW: resize the window freely, the phone rotates to portrait/landscape to match its shape.&#x0a;LOCKED RATIO: the window keeps the phone screen proportions.&#x0a;Click to switch mode (restarts mirroring)."
                        Opacity="{Binding IsAspectRatioUnlocked, Converter={StaticResource BooleanToDoubleConverter}, ConverterParameter=1.0_0.7}"
                        BorderBrush="{Binding IsAspectRatioUnlocked, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#66c0f4_#66c0f4}">
                    <TextBlock Margin="10,3" FontSize="13"
                               Text="{Binding IsAspectRatioUnlocked, Converter={StaticResource BooleanToStringConverter}, ConverterParameter=FREE__WINDOW_LOCKED__RATIO}"
                               Foreground="{Binding IsAspectRatioUnlocked, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#66c0f4_#66c0f4}"/>
                </Button>

                <Button Command="{Binding ToggleAudioCommand}" Margin="1,1,0,0"
                        ToolTip="ON PC: sound plays on the PC, the phone is muted.&#x0a;ON PHONE: sound stays on the phone, the PC plays nothing.&#x0a;Click to switch mode (restarts mirroring)."
                        Opacity="{Binding IsAudioEnabled, Converter={StaticResource BooleanToDoubleConverter}, ConverterParameter=1.0_0.7}"
                        BorderBrush="{Binding IsAudioEnabled, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#66c0f4_#66c0f4}">
                    <TextBlock Margin="10,3" FontSize="13"
                               Text="{Binding IsAudioEnabled, Converter={StaticResource BooleanToStringConverter}, ConverterParameter=SOUND__ON__PC_SOUND__ON__PHONE}"
                               Foreground="{Binding IsAudioEnabled, Converter={StaticResource BooleanToColorConverter}, ConverterParameter=#66c0f4_#66c0f4}"/>
                </Button>
            </UniformGrid>

            <Button Command="{Binding ExitApplicationCommand}">
                <TextBlock Margin="10, 3" Text="Exit" />
            </Button>
        </StackPanel>
    </Border>
</views:BaseWindow>
