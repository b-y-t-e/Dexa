
<Window x:Class="Dexa.Views.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Dexa.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:TrayWindowViewModel}"
        Title="Dexa Tray"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Deactivated="Window_Deactivated">
    <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
        <StackPanel>
            <ListBox ItemsSource="{Binding SampleItems}" DisplayMemberPath="DisplayName" Margin="5"/>
            <Button Content="Help" Command="{Binding ShowHelpCommand}" Margin="5,0,5,5"/>
            <Button Content="Exit" Command="{Binding ExitApplicationCommand}" Margin="5,0,5,5"/>
        </StackPanel>
    </Border>
</Window>
