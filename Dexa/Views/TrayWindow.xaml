
<Window x:Class="Dexa.Views.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Dexa.ViewModels"
        xmlns:converters="clr-namespace:Dexa.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:TrayWindowViewModel}"
        Title="Dexa Tray"
        
        Icon="/Icons/Dexa.ico"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Deactivated="Window_Deactivated">
    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>
    <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
        <StackPanel>
            <ListBox ItemsSource="{Binding Devices}" Margin="5" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="&#xE70B;" FontFamily="Segoe MDL2 Assets" Margin="5,0,0,0"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.ConnectWirelessCommand}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsRemoteConnection, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Help" Command="{Binding ShowHelpCommand}" Margin="5,0,5,5"/>
            <Button Content="Exit" Command="{Binding ExitApplicationCommand}" Margin="5,0,5,5"/>
        </StackPanel>
    </Border>
</Window>
